      <qual:transition qual:id="tr_S_15">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p key="P_regulatorysummary_0" contentType="RegulatorySummary">Wnt3a effect on cell proliferation would be partially mediated by the Ras/Erk pathway (uncertainty, candidate for removal)</p><ul key="P_regulatorysummary_0">
              <li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">15615777</span></li></ul><p key="P_regulatorysummary_1" contentType="RegulatorySummary">Activated FGFRs phosphorylate specific tyrosine residues that mediate interaction with the RAS-MAPK signalling pathway. Canonical</p><ul key="P_regulatorysummary_1">
              <li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">28298517</span></li><li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">25772309</span></li><li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">22488450</span></li></ul><p key="P_regulatorysummary_2" contentType="RegulatorySummary">TGFb and BMP non-canonical pathway includes the activation of the Ras/ERK1/2 kinase axis.</p><ul key="P_regulatorysummary_2">
              <li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">31450621</span></li></ul></body>
        </notes>
        <qual:listOfInputs>
