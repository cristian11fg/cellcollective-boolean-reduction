      <qual:transition qual:id="tr_S_20">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p key="P_regulatorysummary_0" contentType="RegulatorySummary">"IL-1 activates several negative-feedback inhibitors that shut off IL-1R signaling. p38 MAPK-mediated phosphorylation of TAB1 inactivates TAK1"</p><ul key="P_regulatorysummary_0">
              <li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">18021073</span></li><li>
