      <qual:transition qual:id="tr_S_22">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p key="P_regulatorysummary_0" contentType="RegulatorySummary">Dlx5 has an activity which interferes with both abilities of Msx2 to interact with Runx2 and repress its transcriptional activity.</p><ul key="P_regulatorysummary_0">
              <li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">16314053</span></li><li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">11683913</span></li></ul><p key="P_regulatorysummary_1" contentType="RegulatorySummary">Dlx5 stimulates Runx2 activity and negatively regulates Msx2 activity. Evidence suggests Dlx5 might achieve these effects through interfering with interactions between Msx2 and Runx2</p><ul key="P_regulatorysummary_1">
              <li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">10328922</span></li></ul><p key="P_regulatorysummary_2" contentType="RegulatorySummary">Msx2 and Dlx5 form an heterocomplex which prevents each other transcriptional function</p><ul key="P_regulatorysummary_2">
              <li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">15456894</span></li><li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">22253449</span></li><li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">16314053</span></li><li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">9111364</span></li></ul></body>
        </notes>
        <qual:listOfInputs>
          <qual:input qual:id="tr_S_22_in_S_37" qual:qualitativeSpecies="S_37" qual:sign="negative" qual:thresholdLevel="1" qual:transitionEffect="none"/>
