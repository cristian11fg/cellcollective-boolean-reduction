      </qual:transition>
      <qual:transition qual:id="tr_S_4">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p key="P_regulatorysummary_0" contentType="RegulatorySummary">MMP13 or ECM degrading enzymes that contribute to the cleavage of proteglycans, especially during disease such as osteoarthritis or during inflammatory events</p><ul key="P_regulatorysummary_0">
              <li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">16143826</span></li><li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">1730630</span></li><li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">7537757</span></li></ul><p key="P_regulatorysummary_1" contentType="RegulatorySummary">The IL-B and inflammation induced degradation of proteoglycans is mediated by aggrecanase such as MMPs and ADAM</p><ul key="P_regulatorysummary_1">
              <li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">9682788</span></li></ul></body>
        </notes>
        <qual:listOfInputs>
          <qual:input qual:id="tr_S_4_in_S_40" qual:qualitativeSpecies="S_40" qual:sign="negative" qual:thresholdLevel="1" qual:transitionEffect="none">
            <notes>
              <body xmlns="http://www.w3.org/1999/xhtml">
                <p key="P_upstreamregulator_0" contentType="UpstreamRegulator">MMPs cleave and degrade proteoglycans</p><ul key="P_upstreamregulator_0">
                  <li>
                    <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">1730630</span></li><li>
                    <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">7537757</span></li></ul></body>
            </notes>
          </qual:input>
        </qual:listOfInputs>
        <qual:listOfOutputs>
          <qual:output qual:qualitativeSpecies="S_4" qual:transitionEffect="assignmentLevel"/>
        </qual:listOfOutputs>
