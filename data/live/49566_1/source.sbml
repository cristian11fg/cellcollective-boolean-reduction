      <qual:transition qual:id="tr_S_23">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p key="P_regulatorysummary_0" contentType="RegulatorySummary">Pi3K activates Akt by phosphorylation in chondrocytes. This constitutes the canonical PI3K/Akt pathway</p><ul key="P_regulatorysummary_0">
              <li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">25659655</span></li></ul><p key="P_regulatorysummary_1" contentType="RegulatorySummary">Inhibition of Akt is caused by an increase in protein phosphatase 2A (PP2A)-mediated dephosphorylation (reference not chondrocyte specific)</p><ul key="P_regulatorysummary_1">
              <li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">15367694</span></li><li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">20182580</span></li><li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">10995457</span></li></ul></body>
        </notes>
        <qual:listOfInputs>
          <qual:input qual:id="tr_S_23_in_S_57" qual:qualitativeSpecies="S_57" qual:sign="positive" qual:thresholdLevel="1" qual:transitionEffect="none"/>
