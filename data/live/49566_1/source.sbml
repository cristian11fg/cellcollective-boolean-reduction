      <qual:transition qual:id="tr_S_17">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p key="P_regulatorysummary_0" contentType="RegulatorySummary">BMP2 induces ATF4 phosphorylation with downstream signaling involving Ras-ERK1/2-RSK2 activation.</p><ul key="P_regulatorysummary_0">
              <li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">24418675</span></li></ul><p key="P_regulatorysummary_1" contentType="RegulatorySummary">ATF4 function is regulated by phosphorylation. PKA regulates ATF4 by phosphorylation in osteoblast</p><ul key="P_regulatorysummary_1">
              <li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">17141628</span></li><li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">24418675</span></li></ul></body>
        </notes>
        <qual:listOfInputs>
          <qual:input qual:id="tr_S_17_in_S_31" qual:qualitativeSpecies="S_31" qual:sign="positive" qual:thresholdLevel="1" qual:transitionEffect="none">
            <notes>
              <body xmlns="http://www.w3.org/1999/xhtml">
                <p key="P_upstreamregulator_0" contentType="UpstreamRegulator">This interaction is to account for the capacity of BMP2 to activate ATF4 through the MAPK cascade</p></body>
            </notes>
          </qual:input>
