            <notes>
              <body xmlns="http://www.w3.org/1999/xhtml">
                <p key="P_upstreamregulator_0" contentType="UpstreamRegulator">Sox9 and Runx2 are antagonist that inbitis each other and control opposite programs</p><ul key="P_upstreamregulator_0">
                  <li>
                    <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">19341622</span></li></ul></body>
            </notes>
          </qual:input>
          <qual:input qual:id="tr_S_35_in_S_38" qual:qualitativeSpecies="S_38" qual:sign="negative" qual:thresholdLevel="1" qual:transitionEffect="none"/>
