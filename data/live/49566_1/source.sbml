                <or/>
                <apply>
                  <eq/>
                  <ci> S_54 </ci>
                  <cn type="integer"> 1 </cn>
                </apply>
                <apply>
                  <eq/>
                  <ci> S_31 </ci>
                  <cn type="integer"> 1 </cn>
                </apply>
              </apply>
            </math>
