      <qual:transition qual:id="tr_S_36">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p key="P_regulatorysummary_0" contentType="RegulatorySummary">PP2A plays a role in the formation of the destruction complex. It is therefore involved in degradation of Beta-catenin via the DC. (canonical)</p><ul key="P_regulatorysummary_0">
              <li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">23169527</span></li></ul><p key="P_regulatorysummary_1" contentType="RegulatorySummary">ERK dependant phosphorylation of GSK3B (included in DC) tigger other phosphorylations which lead to GSK3B inactivation and upregulation of B-catenin levels. This was not shown in chondrocytes but it is canonical</p><ul key="P_regulatorysummary_1">
              <li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">16039586</span></li></ul><p key="P_regulatorysummary_2" contentType="RegulatorySummary">Activation of Dsh lead to the dissaembly of the DC.</p><ul key="P_regulatorysummary_2">
              <li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">22520685</span></li><li>
                <span class="referType">PMID</span><span class="position">0</span><span class="doi"/><span class="pmid">17659995</span></li></ul></body>
        </notes>
        <qual:listOfInputs>
          <qual:input qual:id="tr_S_36_in_S_60" qual:qualitativeSpecies="S_60" qual:sign="negative" qual:thresholdLevel="1" qual:transitionEffect="none"/>
          <qual:input qual:id="tr_S_36_in_S_53" qual:qualitativeSpecies="S_53" qual:sign="positive" qual:thresholdLevel="1" qual:transitionEffect="none"/>
          <qual:input qual:id="tr_S_36_in_S_31" qual:qualitativeSpecies="S_31" qual:sign="negative" qual:thresholdLevel="1" qual:transitionEffect="none"/>
        </qual:listOfInputs>
